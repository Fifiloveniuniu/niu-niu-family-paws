{
  "openapi": "3.0.3",
  "info": {
    "title": "Family Paws API",
    "version": "1.0.0"
  },
  "components": {
    "securitySchemes": {
      "firebase": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "LinkState": {
        "type": "object", "additionalProperties": false, "required": ["status", "version", "customerVersion"],
        "properties": {"status": {"type": "string", "enum": ["none", "open", "requested", "approved", "rejected", "cancelled", "expired"]}, "version": {"type": "integer", "minimum": 0}, "customerVersion": {"type": "integer", "minimum": 1}, "customerName": {"type": "string"}, "expiresAt": {"type": "string"}, "requestedEmail": {"type": "string"}}
      },
      "LinkCode": {"type": "object", "additionalProperties": false, "required": ["code"], "properties": {"code": {"type": "string", "minLength": 32, "maxLength": 80}}},
      "LinkDecision": {"type": "object", "additionalProperties": false, "required": ["action", "version", "customerVersion"], "properties": {"action": {"type": "string", "enum": ["approve", "reject", "cancel"]}, "version": {"type": "integer", "minimum": 1}, "customerVersion": {"type": "integer", "minimum": 1}}},
      "Pet": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "customerId", "name", "photo", "version", "createdAt", "updatedAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "customerId": { "type": "string", "format": "uuid", "readOnly": true },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "photo": { "type": "string", "nullable": true, "readOnly": true, "description": "Opaque image revision; photos require authenticated API access." },
          "version": { "type": "integer", "minimum": 1 },
          "createdAt": { "type": "string" }, "updatedAt": { "type": "string" }
        }
      },
      "PetWrite": {
        "type": "object", "additionalProperties": false, "required": ["name", "version"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "version": { "type": "integer", "minimum": 0 },
          "photoData": { "type": "string", "minLength": 1, "maxLength": 4194304, "description": "Optional base64 JPEG, PNG or WebP, at most 3 MiB and 16 megapixels. Omit to preserve the saved photo." }
        }
      },
      "PetPage": {
        "type": "object", "required": ["items", "nextCursor"],
        "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Pet" } }, "nextCursor": { "type": "string", "nullable": true } }
      },
      "PetSearchPage": {
        "type": "object", "required": ["items", "nextCursor"],
        "properties": { "items": { "type": "array", "items": { "type": "object", "required": ["pet", "customer"], "properties": {
          "pet": { "$ref": "#/components/schemas/Pet" },
          "customer": { "type": "object", "required": ["id", "name", "loginEmail"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "loginEmail": { "type": "string", "nullable": true } } }
        } } }, "nextCursor": { "type": "string", "nullable": true } }
      },
      "Customer": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "email",
          "phone",
          "language",
          "version",
          "createdAt",
          "updatedAt",
          "loginEmail"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "maxLength": 254
          },
          "phone": {
            "type": "string",
            "maxLength": 40
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "zh"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "loginEmail": {
            "type": "string",
            "nullable": true,
            "readOnly": true,
            "description": "Server-maintained verified Google email, or null for an unlinked record."
          }
        }
      },
      "CustomerWrite": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "email",
          "phone",
          "language",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "maxLength": 254
          },
          "phone": {
            "type": "string",
            "maxLength": 40
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "zh"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "ProfileWrite": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "language", "version"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "language": { "type": "string", "enum": ["en", "zh"] },
          "version": { "type": "integer", "minimum": 0 }
        }
      },
      "CustomerPage": {
        "type": "object",
        "required": [
          "items",
          "nextCursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Customer"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          }
        }
      }
    }
  },
  "security": [
    {
      "firebase": []
    }
  ],
  "paths": {
    "/api/account-link": {
      "get": {"summary": "Read own linking request status", "security": [{"firebase": []}], "responses": {"200": {"description": "Own status only, no unapproved customer data"}, "403": {"description": "Verified Google identity required"}}},
      "post": {"summary": "Submit one-time linking code with verified Google identity", "security": [{"firebase": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LinkCode"}}}}, "responses": {"200": {"description": "Request awaits administrator approval"}, "409": {"description": "Code unavailable or identity already has a profile"}, "429": {"description": "Rate limited"}}}
    },
    "/api/customers/{id}/account-link": {
      "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}],
      "get": {"summary": "Administrator reviews current linking request", "security": [{"firebase": []}], "responses": {"200": {"description": "Current request and customer version", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LinkState"}}}}, "403": {"description": "Administrator required"}}},
      "post": {"summary": "Administrator issues or replaces a 24-hour code", "security": [{"firebase": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false}}}}, "responses": {"200": {"description": "Plaintext code shown once; server stores only its hash"}, "409": {"description": "Customer already has an owner"}}},
      "put": {"summary": "Administrator approves, rejects or cancels a versioned request", "security": [{"firebase": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LinkDecision"}}}}, "responses": {"200": {"description": "Decision saved transactionally", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LinkState"}}}}, "409": {"description": "Stale, expired, already owned or identity changed"}}}
    },
    "/api/customers/{customerId}/pets": {
      "parameters": [{ "name": "customerId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
      "get": { "operationId": "listPets", "description": "Owner or administrator only. 50 pets per page.",
        "parameters": [{ "name": "cursor", "in": "query", "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "Pets", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PetPage" } } } }, "403": { "description": "Not authorized" } }
      }
    },
    "/api/customers/{customerId}/pets/{id}": {
      "parameters": [{ "name": "customerId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
      "put": { "operationId": "savePet", "description": "Owner or administrator only. Customer relationship is immutable. Versioned, audited and safe to retry the identical request.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PetWrite" } } } },
        "responses": { "200": { "description": "Pet saved", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Pet" } } } }, "400": { "description": "Invalid name or image" }, "403": { "description": "Not authorized" }, "409": { "description": "Stale version" } }
      }
    },
    "/api/customers/{customerId}/pets/{id}/photo": {
      "parameters": [{ "name": "customerId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
      "get": { "operationId": "getPetPhoto", "description": "Owner or administrator only; private/no-store. Never a public download URL.", "responses": { "200": { "description": "Private processed photo", "content": { "image/webp": { "schema": { "type": "string", "format": "binary" } } } }, "403": { "description": "Not authorized" }, "404": { "description": "No photo" } } }
    },
    "/api/pet-search": {
      "get": { "operationId": "searchPets", "description": "Administrator-only pet-name prefix search, joined to canonical customer information.",
        "parameters": [{ "name": "search", "in": "query", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 120 } }, { "name": "cursor", "in": "query", "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Pet/customer results", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PetSearchPage" } } } }, "403": { "description": "Administrator required" } }
      }
    },
    "/api/profile": {
      "get": {
        "operationId": "getOwnProfile",
        "description": "Read only the profile belonging to the verified Google identity. No client-selected owner or account linking.",
        "responses": {
          "200": { "description": "Own profile", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Customer" } } } },
          "204": { "description": "No profile has been created for this identity" },
          "401": { "description": "Authentication required" },
          "403": { "description": "Active verified Google identity required" }
        }
      },
      "put": {
        "operationId": "saveOwnProfile",
        "description": "Create or edit the current identity's name and language, preserving canonical contact data and audit history.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProfileWrite" } } } },
        "responses": {
          "200": { "description": "Saved own profile", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Customer" } } } },
          "400": { "description": "Invalid input" },
          "401": { "description": "Authentication required" },
          "403": { "description": "Active verified Google identity required" },
          "409": { "description": "Profile changed since it was loaded" }
        }
      }
    },
    "/api/customers": {
      "get": {
        "operationId": "listCustomers",
        "parameters": [
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "query",
            "name": "search",
            "description": "Case-insensitive prefix of customer name, contact email, or server-maintained Google login email. Applied before pagination.",
            "schema": {
              "type": "string",
              "maxLength": 254
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerPage"
                }
              }
            }
          },
          "400": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/customers/{id}": {
      "put": {
        "operationId": "saveCustomer",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CustomerWrite"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Customer"
                }
              }
            }
          },
          "400": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  }
}
