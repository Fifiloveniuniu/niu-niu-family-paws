{
  "openapi": "3.0.3",
  "info": {
    "title": "Family Paws API",
    "version": "1.0.0"
  },
  "components": {
    "securitySchemes": {
      "firebase": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "WorkspacePets": {"type": "object", "required": ["admin", "customer", "items", "nextCursor"], "properties": {"admin": {"type": "boolean"}, "customer": {"nullable": true, "allOf": [{"$ref": "#/components/schemas/Customer"}]}, "items": {"type": "array", "items": {"type": "object", "required": ["customer", "pet", "account"], "properties": {"customer": {"$ref": "#/components/schemas/Customer"}, "pet": {"$ref": "#/components/schemas/Pet"}, "account": {"nullable": true, "allOf": [{"$ref": "#/components/schemas/BoardingAccount"}]}}}}, "nextCursor": {"type": "string", "nullable": true}}},
      "WorkspaceLocations": {"type": "object", "required": ["items"], "properties": {"items": {"type": "array", "items": {"type": "object", "required": ["house", "rooms"], "properties": {"house": {"$ref": "#/components/schemas/House"}, "rooms": {"type": "array", "items": {"$ref": "#/components/schemas/Room"}}}}}}},
      "BookingWrite": {"type": "object", "additionalProperties": false, "required": ["operationId", "customerId", "petId", "houseId", "roomId", "version", "arrival", "pickup"], "properties": {"operationId": {"type": "string", "format": "uuid"}, "customerId": {"type": "string", "format": "uuid"}, "petId": {"type": "string", "format": "uuid"}, "houseId": {"type": "string", "format": "uuid"}, "roomId": {"type": "string", "format": "uuid"}, "version": {"type": "integer", "minimum": 0, "maximum": 1000000000}, "arrival": {"type": "string", "format": "date-time"}, "pickup": {"type": "string", "format": "date-time"}}},
      "Booking": {"type": "object", "additionalProperties": false, "required": ["occupancyFrom", "occupancyThrough", "customerId", "petId", "houseId", "roomId", "version", "arrival", "pickup", "id", "species", "units", "timezone", "status", "billingStatus", "actualArrival", "actualPickup", "createdAt", "updatedAt"], "properties": {"customerId": {"type": "string", "format": "uuid"}, "petId": {"type": "string", "format": "uuid"}, "houseId": {"type": "string", "format": "uuid"}, "roomId": {"type": "string", "format": "uuid"}, "version": {"type": "integer", "minimum": 0, "maximum": 1000000000}, "arrival": {"type": "string", "format": "date-time"}, "pickup": {"type": "string", "format": "date-time"}, "id": {"type": "string", "format": "uuid"}, "species": {"type": "string", "enum": ["dog", "cat", "rabbit"]}, "units": {"type": "number", "exclusiveMinimum": 0}, "timezone": {"type": "string"}, "status": {"type": "string", "enum": ["planned", "in_care", "completed", "cancelled"]}, "billingStatus": {"type": "string", "enum": ["unbilled"]}, "occupancyFrom": {"type":"string","format":"date-time","readOnly":true}, "occupancyThrough": {"type":"string","format":"date-time","readOnly":true}, "actualArrival": {"type": "string", "format": "date-time", "nullable": true}, "actualPickup": {"type": "string", "format": "date-time", "nullable": true}, "createdAt": {"type": "string", "format": "date-time"}, "updatedAt": {"type": "string", "format": "date-time"}}},
      "BookingAction": {"type": "object", "additionalProperties": false, "required": ["operationId", "version", "action", "at"], "properties": {"operationId": {"type": "string", "format": "uuid"}, "version": {"type": "integer", "minimum": 0, "maximum": 1000000000}, "action": {"type": "string", "enum": ["check_in", "check_out", "cancel"]}, "at": {"type": "string", "format": "date-time"}}},
      "AvailabilityInput": {"type": "object", "additionalProperties": false, "required": ["customerId", "petId", "arrival", "pickup"], "properties": {"customerId": {"type": "string", "format": "uuid"}, "petId": {"type": "string", "format": "uuid"}, "arrival": {"type": "string", "format": "date-time"}, "pickup": {"type": "string", "format": "date-time"}, "bookingId": {"type":"string","format":"uuid"}, "windowFrom": {"type": "string", "format": "date-time"}, "windowThrough": {"type": "string", "format": "date-time"}}},
      "AvailabilityResult": {"type": "object", "required": ["rooms", "from", "through"], "properties": {"rooms": {"type": "array", "items": {"type": "object", "required": ["houseId", "roomId", "houseName", "roomName", "address", "timezone", "available", "issue", "blocked"], "properties": {"houseId": {"type": "string", "format": "uuid"}, "roomId": {"type": "string", "format": "uuid"}, "houseName": {"type": "string"}, "roomName": {"type": "string"}, "address": {"type": "string"}, "timezone": {"type": "string"}, "available": {"type": "boolean"}, "issue": {"type": "string", "enum": ["pet_overlap", "species", "overdue", "turnover_unconfigured", "capacity", "room_setup", "pet_setup", "house_setup"], "nullable": true}, "blocked": {"type": "array", "items": {"type": "object", "required": ["from", "through", "issue"], "properties": {"from": {"type": "string", "format": "date-time"}, "through": {"type": "string", "format": "date-time"}, "issue": {"type": "string", "enum": ["pet_overlap", "species", "overdue", "turnover_unconfigured", "capacity", "room_setup", "pet_setup", "house_setup"]}}}}}}}, "from": {"type": "string", "format": "date-time"}, "through": {"type": "string", "format": "date-time"}}},

      "BoardingAccount": {"type": "object", "additionalProperties": false, "required": ["customerId", "petId", "service", "days", "validFrom", "validThrough", "version", "createdAt", "updatedAt"], "properties": {"customerId": {"type": "string", "format": "uuid"}, "petId": {"type": "string", "format": "uuid"}, "service": {"type": "string", "enum": ["boarding"]}, "days": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "validFrom": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}, "validThrough": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}, "version": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "createdAt": {"type": "string"}, "updatedAt": {"type": "string"}}},
      "BoardingAdjustment": {"type": "object", "additionalProperties": false, "required": ["operationId", "version", "delta", "validFrom", "validThrough", "reason"], "properties": {"operationId": {"type": "string", "format": "uuid"}, "version": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "delta": {"type": "integer", "minimum": -1000000, "maximum": 1000000}, "validFrom": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}, "validThrough": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}, "reason": {"type": "string", "maxLength": 1000}}},
      "BoardingEvent": {"type": "object", "additionalProperties": false, "required": ["id", "customerId", "petId", "version", "delta", "daysAfter", "validFrom", "validThrough", "reason", "at"], "properties": {"id": {"type": "string", "format": "uuid"}, "customerId": {"type": "string", "format": "uuid"}, "petId": {"type": "string", "format": "uuid"}, "version": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "delta": {"type": "integer"}, "daysAfter": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "validFrom": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}, "validThrough": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}, "reason": {"type": "string"}, "actor": {"type": "string"}, "at": {"type": "string"}}},
      "BoardingBalanceRead": {"type": "object", "required": ["account", "events", "nextCursor"], "properties": {"account": {"nullable": true, "allOf": [{"$ref": "#/components/schemas/BoardingAccount"}]}, "events": {"type": "array", "items": {"$ref": "#/components/schemas/BoardingEvent"}}, "nextCursor": {"type": "integer", "nullable": true}}},

      "RoomWrite": {"type": "object", "additionalProperties": false, "required": ["name", "capacity", "costs", "version"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 120}, "capacity": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000000}, "costs": {"type": "object", "additionalProperties": false, "properties": {"dog": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000000}, "cat": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000000}, "rabbit": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000000}}}, "version": {"type": "integer", "minimum": 0}}},
      "Room": {"allOf": [{"$ref": "#/components/schemas/RoomWrite"}, {"type": "object", "required": ["id", "houseId", "createdAt", "updatedAt"], "properties": {"id": {"type": "string", "format": "uuid"}, "houseId": {"type": "string", "format": "uuid"}, "createdAt": {"type": "string"}, "updatedAt": {"type": "string"}}}]},
      "HouseWrite": {"type": "object", "additionalProperties": false, "required": ["name", "address", "timezone", "version"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 120}, "address": {"type": "string", "minLength": 1, "maxLength": 500}, "timezone": {"type": "string", "minLength": 1, "maxLength": 100}, "version": {"type": "integer", "minimum": 0}}},
      "House": {"allOf": [{"$ref": "#/components/schemas/HouseWrite"}, {"type": "object", "required": ["id", "createdAt", "updatedAt"], "properties": {"id": {"type": "string", "format": "uuid"}, "createdAt": {"type": "string"}, "updatedAt": {"type": "string"}}}]},
      "LinkState": {
        "type": "object", "additionalProperties": false, "required": ["status", "version", "customerVersion"],
        "properties": {"status": {"type": "string", "enum": ["none", "open", "requested", "approved", "rejected", "cancelled", "expired"]}, "version": {"type": "integer", "minimum": 0}, "customerVersion": {"type": "integer", "minimum": 1}, "customerName": {"type": "string"}, "expiresAt": {"type": "string"}, "requestedEmail": {"type": "string"}}
      },
      "LinkCode": {"type": "object", "additionalProperties": false, "required": ["code"], "properties": {"code": {"type": "string", "minLength": 32, "maxLength": 80}}},
      "LinkDecision": {"type": "object", "additionalProperties": false, "required": ["action", "version", "customerVersion"], "properties": {"action": {"type": "string", "enum": ["approve", "reject", "cancel"]}, "version": {"type": "integer", "minimum": 1}, "customerVersion": {"type": "integer", "minimum": 1}}},
      "Pet": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "customerId", "name", "photo", "version", "createdAt", "updatedAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "customerId": { "type": "string", "format": "uuid", "readOnly": true },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "species": {"type": "string", "nullable": true, "enum": ["dog", "cat", "rabbit", null]},
          "weightKg": {"type": "number", "nullable": true, "exclusiveMinimum": 0, "maximum": 1000},
          "photo": { "type": "string", "nullable": true, "readOnly": true, "description": "Opaque image revision; photos require authenticated API access." },
          "photoCredit": { "type": "object", "readOnly": true, "additionalProperties": false, "required": ["creator", "sourcePage", "license", "licenseUrl"], "properties": { "creator": { "type": "string" }, "sourcePage": { "type": "string" }, "license": { "type": "string" }, "licenseUrl": { "type": "string" } } },
          "version": { "type": "integer", "minimum": 1 },
          "createdAt": { "type": "string" }, "updatedAt": { "type": "string" }
        }
      },
      "PetWrite": {
        "type": "object", "additionalProperties": false, "required": ["name", "version"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "species": {"type": "string", "nullable": true, "enum": ["dog", "cat", "rabbit", null]},
          "weightKg": {"type": "number", "nullable": true, "exclusiveMinimum": 0, "maximum": 1000},
          "version": { "type": "integer", "minimum": 0 },
          "photoData": { "type": "string", "minLength": 1, "maxLength": 4194304, "description": "Optional base64 JPEG, PNG or WebP, at most 3 MiB and 16 megapixels. Omit to preserve the saved photo." }
        }
      },
      "PetPage": {
        "type": "object", "required": ["items", "nextCursor"],
        "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Pet" } }, "nextCursor": { "type": "string", "nullable": true } }
      },
      "PetSearchPage": {
        "type": "object", "required": ["items", "nextCursor"],
        "properties": { "items": { "type": "array", "items": { "type": "object", "required": ["pet", "customer"], "properties": {
          "pet": { "$ref": "#/components/schemas/Pet" },
          "customer": { "type": "object", "required": ["id", "name", "loginEmail"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "loginEmail": { "type": "string", "nullable": true } } }
        } } }, "nextCursor": { "type": "string", "nullable": true } }
      },
      "Customer": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "email",
          "phone",
          "language",
          "version",
          "createdAt",
          "updatedAt",
          "loginEmail"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "maxLength": 254
          },
          "phone": {
            "type": "string",
            "maxLength": 40
          },
          "language": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$", "maxLength": 35 },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "loginEmail": {
            "type": "string",
            "nullable": true,
            "readOnly": true,
            "description": "Server-maintained verified Google email, or null for an unlinked record."
          }
        }
      },
      "CustomerWrite": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "email",
          "phone",
          "language",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "maxLength": 254
          },
          "phone": {
            "type": "string",
            "maxLength": 40
          },
          "language": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$", "maxLength": 35 },
          "version": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "ProfileWrite": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "language", "version"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "language": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$", "maxLength": 35 },
          "version": { "type": "integer", "minimum": 0 }
        }
      },
      "CustomerPage": {
        "type": "object",
        "required": [
          "items",
          "nextCursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Customer"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          }
        }
      }
    }
  },
  "security": [
    {
      "firebase": []
    }
  ],
  "paths": {
    "/api/workspace/pets": {"get": {"summary": "Paginated canonical pet/customer/balance rows for current admin or own effective customer", "parameters": [{"name": "customerId", "in": "query", "schema": {"type": "string"}}, {"name": "cursor", "in": "query", "schema": {"type": "string"}}], "responses": {"200": {"description": "Scoped pet rows with current balances", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WorkspacePets"}}}}}}},
    "/api/workspace/locations": {"get": {"summary": "Authorized house/room catalog; no private stays or customer identities", "responses": {"200": {"description": "Saved locations", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WorkspaceLocations"}}}}}}},

    "/api/availability": {"post": {"summary": "Whole-stay availability with aggregated blocked spans; no other customer identities", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AvailabilityInput"}}}}, "responses": {"200": {"description": "Result", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AvailabilityResult"}}}}}}},
    "/api/bookings/{id}": {"get":{"summary":"Read an owned or administrator booking by stable identifier","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Scoped booking","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Booking"}}}}}}, "put": {"summary": "Save an unbilled planned placement or edit an active booking (administrator only until billing rules are configured)", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/BookingWrite"}}}}, "responses": {"200": {"description": "Result", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Booking"}}}}}}},
    "/api/bookings/{id}/actions": {"post": {"summary": "Record actual check-in, pickup, or cancel an unbilled plan (administrator only)", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/BookingAction"}}}}, "responses": {"200": {"description": "Result", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Booking"}}}}}}},
    "/api/bookings": {"get": {"summary": "Paginated administrator or own-customer bookings", "parameters": [{"name":"from","in":"query","schema":{"type":"string","format":"date-time"}},{"name":"through","in":"query","schema":{"type":"string","format":"date-time"}},{"name": "customerId", "in": "query", "schema": {"type": "string", "format": "uuid"}}, {"name": "cursor", "in": "query", "schema": {"type": "string", "format": "uuid"}}], "responses": {"200": {"description": "Scoped bookings", "content": {"application/json": {"schema": {"type": "object", "required": ["items", "nextCursor"], "properties": {"items": {"type": "array", "items": {"$ref": "#/components/schemas/Booking"}}, "nextCursor": {"type": "string", "nullable": true}}}}}}}}},

    "/api/customers/{customerId}/pets/{petId}/balance": {"get": {"summary": "Read own pet balance and paginated recorded history; administrators may read any pet", "parameters": [{"name": "customerId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}, {"name": "petId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}, {"name": "cursor", "in": "query", "schema": {"type": "string"}}], "responses": {"200": {"description": "Balance and history", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/BoardingBalanceRead"}}}}}}, "put": {"summary": "Audited idempotent administrator manual adjustment (no payment or automatic booking deduction)", "parameters": [{"name": "customerId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}, {"name": "petId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/BoardingAdjustment"}}}}, "responses": {"200": {"description": "Saved account", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/BoardingAccount"}}}}}}},
    "/api/houses/{houseId}/rooms": {"get":{"summary":"List saved rooms (administrator only)","parameters":[{"name":"houseId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Saved rooms","content":{"application/json":{"schema":{"type":"object","required":["items"],"properties":{"items":{"type":"array","items":{"$ref":"#/components/schemas/Room"}}}}}}}}}},
    "/api/houses/{houseId}/rooms/{id}": {"put":{"summary":"Save room configuration with version and occupancy checks (administrator only)","parameters":[{"name":"houseId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RoomWrite"}}}},"responses":{"200":{"description":"Saved room","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Room"}}}}}}},
    "/api/houses": {"get": {"summary": "List houses (administrator only)", "responses": {"200": {"description": "Houses", "content": {"application/json": {"schema": {"type": "object", "required": ["items"], "properties": {"items": {"type": "array", "items": {"$ref": "#/components/schemas/House"}}}}}}}}}},
    "/api/houses/{id}": {"put": {"summary": "Create or edit a house (administrator only)", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HouseWrite"}}}}, "responses": {"200": {"description": "Saved house", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/House"}}}}}}},
    "/api/account-link": {
      "get": {"summary": "Read own linking request status", "security": [{"firebase": []}], "responses": {"200": {"description": "Own status only, no unapproved customer data"}, "403": {"description": "Verified Google identity required"}}},
      "post": {"summary": "Submit one-time linking code with verified Google identity", "security": [{"firebase": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LinkCode"}}}}, "responses": {"200": {"description": "Request awaits administrator approval"}, "409": {"description": "Code unavailable or identity already has a profile"}, "429": {"description": "Rate limited"}}}
    },
    "/api/customers/{id}/account-link": {
      "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}],
      "get": {"summary": "Administrator reviews current linking request", "security": [{"firebase": []}], "responses": {"200": {"description": "Current request and customer version", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LinkState"}}}}, "403": {"description": "Administrator required"}}},
      "post": {"summary": "Administrator issues or replaces a 24-hour code", "security": [{"firebase": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false}}}}, "responses": {"200": {"description": "Plaintext code shown once; server stores only its hash"}, "409": {"description": "Customer already has an owner"}}},
      "put": {"summary": "Administrator approves, rejects or cancels a versioned request", "security": [{"firebase": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LinkDecision"}}}}, "responses": {"200": {"description": "Decision saved transactionally", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LinkState"}}}}, "409": {"description": "Stale, expired, already owned or identity changed"}}}
    },
    "/api/customers/{customerId}/pets": {
      "parameters": [{ "name": "customerId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
      "get": { "operationId": "listPets", "description": "Owner or administrator only. 50 pets per page.",
        "parameters": [{ "name": "cursor", "in": "query", "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "Pets", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PetPage" } } } }, "403": { "description": "Not authorized" } }
      }
    },
    "/api/customers/{customerId}/pets/{id}": {
      "parameters": [{ "name": "customerId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
      "put": { "operationId": "savePet", "description": "Owner or administrator only. Customer relationship is immutable. Versioned, audited and safe to retry the identical request.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PetWrite" } } } },
        "responses": { "200": { "description": "Pet saved", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Pet" } } } }, "400": { "description": "Invalid name or image" }, "403": { "description": "Not authorized" }, "409": { "description": "Stale version" } }
      }
    },
    "/api/customers/{customerId}/pets/{id}/photo": {
      "parameters": [{ "name": "customerId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
      "get": { "operationId": "getPetPhoto", "description": "Owner or administrator only; private/no-store. Never a public download URL.", "responses": { "200": { "description": "Private processed photo", "content": { "image/webp": { "schema": { "type": "string", "format": "binary" } } } }, "403": { "description": "Not authorized" }, "404": { "description": "No photo" } } }
    },
    "/api/pet-search": {
      "get": { "operationId": "searchPets", "description": "Administrator-only pet-name prefix search, joined to canonical customer information.",
        "parameters": [{ "name": "search", "in": "query", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 120 } }, { "name": "cursor", "in": "query", "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Pet/customer results", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PetSearchPage" } } } }, "403": { "description": "Administrator required" } }
      }
    },
    "/api/profile": {
      "get": {
        "operationId": "getOwnProfile",
        "description": "Read only the profile belonging to the verified Google identity. No client-selected owner or account linking.",
        "responses": {
          "200": { "description": "Own profile", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Customer" } } } },
          "204": { "description": "No profile has been created for this identity" },
          "401": { "description": "Authentication required" },
          "403": { "description": "Active verified Google identity required" }
        }
      },
      "put": {
        "operationId": "saveOwnProfile",
        "description": "Create or edit the current identity's name and language, preserving canonical contact data and audit history.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProfileWrite" } } } },
        "responses": {
          "200": { "description": "Saved own profile", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Customer" } } } },
          "400": { "description": "Invalid input" },
          "401": { "description": "Authentication required" },
          "403": { "description": "Active verified Google identity required" },
          "409": { "description": "Profile changed since it was loaded" }
        }
      }
    },
