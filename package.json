{
  "name": "niu-niu-family-paws",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "npm run build && firebase deploy --only hosting --project niu-niu-family-paws",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:browser": "firebase emulators:exec --only auth --project demo-niu-niu --config firebase.test.json \"playwright test\"",
    "admin:access": "node scripts/admin-access.mjs"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "i18next": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^16.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "firebase-tools": "^14.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
