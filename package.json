{
  "name": "niu-niu-family-paws",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs",
    "preview": "vite preview --host localhost",
    "deploy": "npm run build && firebase deploy --only hosting --project niu-niu-family-paws",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:browser": "firebase emulators:exec --only auth --project demo-niu-niu --config firebase.test.json \"playwright test\"",
    "admin:access": "node scripts/admin-access.mjs",
    "contracts": "openapi-typescript packages/contracts/openapi.json -o packages/contracts/generated.ts",
    "dev:api": "node --watch apps/api/src/server.ts",
    "check:api": "tsc --project apps/api/tsconfig.json",
    "test:store": "firebase emulators:exec --only auth,firestore --project demo-niu-niu --config firebase.test.json \"node --test --test-concurrency=1 tests/*integration.mjs\"",
    "dev:local": "FAMILY_PAWS_LOCAL_DEMO=true vite --mode test --host localhost --port 4180 --strictPort",
    "dev:local:api": "FAMILY_PAWS_EMULATORS=true GCLOUD_PROJECT=demo-niu-niu FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIRESTORE_EMULATOR_HOST=127.0.0.1:8085 PORT=8081 node --watch apps/api/src/server.ts",
    "dev:local:emulators": "firebase emulators:start --only auth,firestore --project demo-niu-niu --config firebase.test.json",
    "seed:local:photos": "GCLOUD_PROJECT=demo-niu-niu FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIRESTORE_EMULATOR_HOST=127.0.0.1:8085 node scripts/seed-local-photo-pets.mjs",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css}\" \"scripts/*.mjs\" \"tests/**/*.{ts,mjs}\" \"*.{json,ts}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css}\" \"scripts/*.mjs\" \"tests/**/*.{ts,mjs}\" \"*.{json,ts}\"",
    "test:backend-browser": "firebase emulators:exec --only auth,firestore --project demo-niu-niu --config firebase.test.json \"playwright test --config playwright.backend.config.ts\"",
    "seed:local:workflows": "GCLOUD_PROJECT=demo-niu-niu FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIRESTORE_EMULATOR_HOST=127.0.0.1:8085 node scripts/seed-local-workflows.mjs",
    "test:local:browser": "playwright test --config playwright.local.config.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "fastify": "^5.12.7",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "i18next": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^16.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "firebase-tools": "^14.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "3.10.1",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
